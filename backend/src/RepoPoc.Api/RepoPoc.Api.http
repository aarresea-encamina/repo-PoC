@RepoPoc.Api_HostAddress = http://localhost:5224

# @name login
POST {{RepoPoc.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "Admin123!"
}

###

@token = {{login.response.body.$.token}}

GET {{RepoPoc.Api_HostAddress}}/api/users
Authorization: Bearer {{token}}

###

POST {{RepoPoc.Api_HostAddress}}/api/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "username": "jdoe",
  "password": "Secret123!",
  "firstName": "John",
  "lastName": "Doe",
  "email": "jdoe@example.com",
  "phone": "600000000"
}

###
